# Centrano dealer account
CENTRANO_EMAIL=your-email@example.com
CENTRANO_PASSWORD=your-password

# Shopify store
SHOPIFY_STORE=pride-scooter.myshopify.com

# Shopify app from the Dev Dashboard (needs the write_products scope and must be
# installed on the store). The script exchanges these for a 24-hour access token.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ...or, for an older custom app made in the Shopify admin, its fixed Admin API token
# SHOPIFY_ACCESS_TOKEN=shpat_xxx

# Optional
# SHOPIFY_API_VERSION=2026-07
# EUR_TO_RON=4.97
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
